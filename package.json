{
  "name": "discord-escrow-bot",
  "version": "2.0.0",
  "private": true,
  "description": "Controle de pedidos e pagamentos com repasse manual auditado",
  "type": "module",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.js",
    "deploy-commands": "node --env-file-if-exists=.env src/deploy-commands.js",
    "test": "node --test",
    "check": "node scripts/check.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js"
  },
  "dependencies": { "discord.js": "14.27.0" }
}
