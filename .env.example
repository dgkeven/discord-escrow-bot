# --- Discord ---
DISCORD_TOKEN=coloque_o_token_do_bot_aqui
DISCORD_CLIENT_ID=id_da_aplicacao_no_discord_developer_portal
DISCORD_GUILD_ID=id_do_seu_servidor_discord
# ID do cargo de staff/moderador que pode liberar pagamentos e resolver disputas
STAFF_ROLE_ID=id_do_cargo_de_staff

# --- Mercado Pago ---
# Access Token da sua conta Mercado Pago (Painel de Desenvolvedores > Suas integrações)
MP_ACCESS_TOKEN=coloque_seu_access_token_aqui
# URL pública onde o webhook do Mercado Pago vai te avisar sobre pagamentos
# (em produção, use um domínio real; em teste local, use ngrok)
MP_WEBHOOK_URL=https://seu-dominio.com/webhooks/mercadopago
# URL para onde o comprador volta depois de pagar (pode ser um canal/link qualquer)
MP_SUCCESS_URL=https://discord.com/channels/@me

# --- App ---
PORT=3000
# Quantos dias sem confirmação nem disputa até o bot avisar/pedir ação da staff
PRAZO_CONFIRMACAO_DIAS=3
